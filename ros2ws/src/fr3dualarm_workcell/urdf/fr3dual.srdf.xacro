<?xml version="1.0" encoding="utf-8"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3dual">

  <xacro:include filename="$(find franka_description)/robots/common/franka_arm.srdf.xacro"/>

  <!-- robot model ID -->
  <xacro:arg name="robot_type" default="fr3"/>

  <!-- robot prefix -->
  <xacro:arg name="arm_prefix" default=""/>
  
  <!-- bool flag for not printing prefix -->
  <xacro:arg name="no_prefix" default="false"/>

  <!-- bool flag for having the gripper/end-effector -->
   <xacro:arg name="hand" default="true"/>

  <!-- which end-effector to use if "hand" is true -->
  <xacro:arg name="ee_id" default="franka_hand"/>

  <!-- Append an underscore to the user-provided prefix, if non-empty. -->
  <!-- <xacro:property name="prefix" value="$(arg arm_prefix)"/> -->
  <!-- <xacro:property name="modified_prefix" value="${prefix + '_' if prefix else ''}"/> -->

  <xacro:franka_arm_srdf robot_type="$(arg robot_type)"
                      hand="$(arg hand)"
                      ee_id="$(arg ee_id)"
                      no_prefix="$(arg no_prefix)"
                      arm_prefix="${modified_prefix}">
  </xacro:franka_arm_srdf>

</robot>