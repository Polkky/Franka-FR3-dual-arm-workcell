<?xml version="1.0" encoding="utf-8"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3dual">

  <xacro:include filename="$(find fr3dualarm_workcell)/urdf/fr3dual.xacro"/>

  <!-- Define arguments -->
  <!-- robot model ID -->
  <xacro:arg name="robot_type" default="fr3"/>

  <!-- robot prefixes for left and right -->
  <xacro:arg name="left_prefix" default="left"/>
  <xacro:arg name="right_prefix" default="right"/>
  
  <!-- bool flag for not printing prefix -->
  <xacro:arg name="no_prefix" default="false"/>

  <!-- bool flag for having the gripper/end-effector -->
   <xacro:arg name="hand" default="true"/>

  <!-- which end-effector to use if "hand" is true -->
  <xacro:arg name="ee_id" default="franka_hand"/>

  <!-- special connection for end-effector -->
  <xacro:arg name="special_connection" default=""/>

  <!-- end-effector x,y,z offset -->
  <xacro:arg name="xyz_ee" default="0 0 0"/>

  <!-- end-effector r,p,y offset -->
  <xacro:arg name="rpy_ee" default="0 0 ${-pi/4}"/>

  <!-- x,y,z offset between tcp and end-effector -->
  <xacro:arg name="tcp_xyz" default=""/>

  <!-- r,p,y offset between tcp and end-effector -->
  <xacro:arg name="tcp_rpy" default="0 0 0"/>

  <!-- safety distance for collision capsules -->
  <xacro:arg name="safety_distance" default="0.03"/>

  <!-- bool flag for allowing self collision -->
  <xacro:arg name="with_sc" default="false"/>

  <!-- Emit the coarse self-collision capsule geometry inside the *_sc sub-links? -->
  <xacro:arg name="include_self_collision_geometry" default="true"/>

  <!-- frame that the robot base is attached to -->
  <xacro:arg name="connected_to" default="base"/>

  <!-- description package -->
  <xacro:arg name="description_pkg" default="franka_description"/>

  <!-- left xyz and rpy offset with the world -->
  <xacro:arg name="left_xyz" default="0 0 0"/>
  <xacro:arg name="left_rpy" default="0 0 0"/>

  <!-- right robot xyz and rpy offset with the world -->
  <xacro:arg name="right_xyz" default="0 0 0"/>
  <xacro:arg name="right_rpy" default="0 0 0"/>

  <!-- frame to which we attach the robot -->
  <xacro:arg name="base_mount" default="base"/>
  <xacro:property name="base_mount_str" value="$(arg base_mount)"/>
  <xacro:if value="${base_mount_str == 'base'}">
    <link name="${base_mount_str}"/>
  </xacro:if>

  <xacro:fr3dual robot_type="$(arg robot_type)"
    left_prefix="$(arg left_prefix)"
    right_prefix="$(arg right_prefix)"
    no_prefix="$(arg no_prefix)"
    hand="$(arg hand)"
    ee_id="$(arg ee_id)"
    special_connection="$(arg special_connection)"
    left_xyz="$(arg left_xyz)"
    left_rpy="$(arg left_rpy)"
    right_xyz="$(arg right_xyz)"
    right_rpy="$(arg right_rpy)"
    xyz_ee="$(arg xyz_ee)"
    rpy_ee="$(arg rpy_ee)"
    tcp_xyz="$(arg tcp_xyz)"
    tcp_rpy="$(arg tcp_rpy)"
    safety_distance="$(arg safety_distance)"
    with_sc="$(arg with_sc)"
    include_self_collision_geometry="$(arg include_self_collision_geometry)"
    connected_to="${base_mount_str}"
    description_pkg="$(arg description_pkg)">
  </xacro:fr3dual>

</robot>